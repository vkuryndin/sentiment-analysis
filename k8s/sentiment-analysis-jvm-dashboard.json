          "editorMode": "code",
          "expr": "100 * avg by (pod) (process_cpu_usage{app=\"sentiment-analysis\",namespace=\"default\",job=\"kubernetes-pods\"})",
          "legendFormat": "{{pod}}",
          "format": "time_series",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
