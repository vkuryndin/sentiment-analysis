            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (pod) (jvm_threads_live_threads{app=\"sentiment-analysis\",namespace=\"default\",job=\"kubernetes-pods\"})",
          "legendFormat": "{{pod}}",
          "format": "time_series",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
