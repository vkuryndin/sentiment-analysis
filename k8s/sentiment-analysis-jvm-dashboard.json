        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Время работы приложения",
      "type": "timeseries",
      "description": "Время работы JVM с момента запуска. При создании новой реплики или перезапуске начинается заново.",
      "datasource": {
